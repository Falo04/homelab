{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "customManagers:githubActionsVersions",
    "helpers:pinGitHubActionDigests"
  ],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "automerge": false,
  "separateMajorMinor": false,
  "rebaseWhen": "behind-base-branch",
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "flexible",
  "pre-commit": { "enabled": true },
  "argocd": {
    "managerFilePatterns": ["/^apps/.+\\.ya?ml$/", "/^bootstrap/.+\\.ya?ml$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/^apps/.+\\.ya?ml$/", "/^base/.+\\.ya?ml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Argo CD chart version in the bootstrap script",
      "managerFilePatterns": ["/^scripts/bootstrap-argocd\\.sh$/"],
      "matchStrings": ["CHART_VERSION=\"(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "helm",
      "depNameTemplate": "argo-cd",
      "registryUrlTemplate": "https://argoproj.github.io/argo-helm"
    },
    {
      "customType": "regex",
      "description": "Digest-pinned images in Argo CD Application Helm values",
      "managerFilePatterns": ["/^apps/infra/applications/.+\\.ya?ml$/"],
      "matchStrings": ["repository: (?<depName>\\S+)\\n\\s+tag: \"(?<currentValue>[^@\"]+)@(?<currentDigest>sha256:[a-f0-9]+)\""],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Update Argo CD Application and bootstrap script together",
      "matchDepNames": ["argo-cd"],
      "groupName": "argo-cd"
    },
    {
      "description": "Vault: no downgrades, step one minor at a time, manual approval",
      "matchDepNames": ["hashicorp/vault"],
      "separateMajorMinor": true,
      "separateMultipleMinor": true,
      "dependencyDashboardApproval": true
    },
    {
      "description": "sops-secrets-operator holds the cluster key: chart and image together, manual approval",
      "matchDepNames": ["sops-secrets-operator", "quay.io/isindir/sops-secrets-operator"],
      "groupName": "sops-secrets-operator",
      "dependencyDashboardApproval": true
    },
    {
      "description": "openGym's API and web images are one release",
      "matchPackageNames": [
        "ghcr.io/duartesantos8/opengym-api",
        "ghcr.io/duartesantos8/opengym-web"
      ],
      "groupName": "opengym"
    }
  ]
}
